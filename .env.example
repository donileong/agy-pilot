# ==============================================================================
# Antigravity Pilot (agy-pilot) Configuration Template
# Copy this file to .env or ~/.config/agy-pilot/config.env
# ==============================================================================

# IM Adapter to activate (default: telegram)
AGY_ADAPTER=telegram

# Telegram Bot API Token obtained from @BotFather
# Example: 123456789:ABCdef-ghijklm_nopqrstuvwxyz
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Whitelist of Telegram User IDs allowed to access Antigravity Pilot.
# Get your numeric User ID by messaging @userinfobot on Telegram.
# Supports a single ID or comma-separated list of multiple IDs.
# Example: 12345678,87654321
TELEGRAM_ALLOWED_USER_IDS=12345678

# Logging verbosity level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
